{
  "log_level": "INFO",
  "paths": {
    "input_folder": "input",
    "pdf_images": "output/pdf_images",
    "ocr_images": "output/ocr_images",
    "json_output": "output/json",
    "manual_review": "output/manual_review",
    "reconstructed_pdf": "output/reconstructed_pdf"
  },
  "pdf": {
    "dpi": 300,
    "image_format": "png",
    "overwrite_existing": false,
    "recursive": false
  },
  "preprocessing": {
    "low_brightness": 80,
    "high_brightness": 220,
    "low_contrast": 40,
    "severe_blur": 50,
    "recursive": false
  },
  "ocr": {
    "language": "en",
    "device": "gpu:0",
    "recursive": false,
    "ocr_version": "PP-OCRv5",
    "text_recognition_batch_size": 1,
    "use_doc_orientation_classify": false,
    "use_doc_unwarping": false,
    "use_textline_orientation": false,
    "use_seal_recognition": false,
    "use_formula_recognition": false,
    "use_chart_recognition": false,
    "use_region_detection": false,
    "models": {
      "layout": {
        "model_name": "PP-DocLayout-L",
        "layout_model_dir": null,
        "model_dir": null
      },
      "text_detection": {
        "model_name": "PP-OCRv5_server_det",
        "model_dir": null
      },
      "text_recognition": {
        "model_name": "PP-OCRv5_server_rec",
        "model_dir": null
      }
    },
    "table": {
      "enabled": true,
      "classification_model": "PP-LCNet_x1_0_table_cls",
      "wired_model": "SLANeXt_wired",
      "wireless_model": "SLANeXt_wireless",
      "table_classification_model_dir": null,
      "wired_model_dir": null,
      "wireless_model_dir": null
    },
    "prediction": {
      "use_table_orientation_classify": false,
      "use_ocr_results_with_table_cells": true
    },
    "table_evaluation": {
      "enabled": true,
      "retry_with_alternative": true,
      "minimum_recognized_cells": 1,
      "minimum_mean_confidence": 0.45,
      "review_when_no_table_detected": true
    }
  }
}
